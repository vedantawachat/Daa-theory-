#include <stdio.h>
	
	
	int parent[vertices];
int key[vertices];
bool mstSet[vertices];

for (int i = 0; i < vertices; i++) {
    key[i] = INT_MAX;
    mstSet[i] = false;
    parent[i] = -1;
}

key[0] = 0;

for (int count = 0; count < vertices - 1; count++) {
    int u = minKey(key, mstSet, vertices);

    mstSet[u] = true;

    for (int v = 0; v < vertices; v++) {
        if (graph[u][v] != 0 &&
            !mstSet[v] &&
            graph[u][v] < key[v]) {
            parent[v] = u;
            key[v] = graph[u][v];
        }
    }

}

