    // 5. MST find karna aur print karna
    for (int i = 0; i < edgeCount; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int w = edges[i].weight;

        // Find root of u
        int rootU = u;
        while (parent[rootU] != rootU) {
            rootU = parent[rootU];
        }

        // Find root of v
        int rootV = v;
        while (parent[rootV] != rootV) {
            rootV = parent[rootV];
        }

        // Cycle detect na hone par edge accept karein
        if (rootU != rootV) {
            printf("Edge %d:(%d, %d) cost:%d\n", mstEdges, u, v, w);
            totalCost += w;
            parent[rootU] = rootV;
            mstEdges++;
            
            if (mstEdges == V - 1) {
                break;
            }
        }
    }

    printf("Minimum cost= %d\n", totalCost);

    free(edges);
    free(parent);
}


